# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle deja acá la salida del módulo `android`, que no es la del `/build`
# de la raíz y no estaba ignorada: aparecía como ruido en cada `git status`.
/android/build/

# Claves y configuración sensible (T-01). Las claves de Supabase entran por
# --dart-define; nunca se hardcodean ni se commitean.
.env
.env.*
!.env.example
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
*.keystore
*.jks
/android/key.properties
# Clave de Google Maps para el SDK nativo de iOS (CU-16). El `.example` sí va.
/ios/Flutter/Maps.xcconfig
