# Laburito — plantilla de variables de entorno
#
# Copiala como `.env` en la raíz del repo y completá los dos valores.
# `.env` está en el .gitignore: las claves nunca se commitean.
#
#   cp .env.example .env
#
# Los dos valores salen de Supabase → Settings.
#
# SUPABASE_ANON_KEY tiene que ser la clave PÚBLICA:
#   ✅  sb_publishable_...   (panel nuevo: Settings → API Keys → Publishable key)
#   ✅  eyJhbGciOi...        (panel clásico: Project API keys → anon / public)
#   ❌  sb_secret_... o service_role. Supabase la rechaza en el navegador con un
#       401 "Forbidden use of secret API key in browser", y con razón: esa clave
#       saltea todas las políticas RLS. Solo va en un servidor.
#
# La pública es publicable por diseño: lo que protege los datos es la RLS.
#
# Se consumen con --dart-define-from-file=.env y se leen en lib/core/config/env.dart
# mediante String.fromEnvironment. Comentarios con # y líneas vacías están permitidos;
# valores multilínea no.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# CU-16 — Google Maps Platform. Vacía por defecto: sin ella el mapa no se
# dibuja pero el resto de la app arranca igual (ver Env.googleMapsApiKey).
# Habilitá en la consola de Google Cloud, para este proyecto: Maps JavaScript
# API, Places API (New) y Geocoding API.
GOOGLE_MAPS_API_KEY=

# Sprint 5 — raíz de la Web publicada (Firebase Hosting). Los enlaces del perfil
# público (CU-26) y de calificación (CU-28) que la app manda por WhatsApp
# apuntan acá. Vacía: en la Web se usa el origen de la página; en la app, el
# sitio de Hosting del proyecto (ver Env.webUrl).
WEB_URL=https://byto-laburitoapp-2e5af.web.app
