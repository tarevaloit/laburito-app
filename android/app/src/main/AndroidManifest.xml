<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="laburito"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- CU-16: clave de Google Maps Platform. El SDK nativo no lee el
             dart-define de Flutter, así que este placeholder lo rellena
             Gradle desde `android/app/build.gradle.kts` (variable de entorno
             MAPS_API_KEY o `android/local.properties`, que está en el
             .gitignore). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- CU-21: canal donde caen las alertas de pedidos si no traen uno
             propio. Lo crea MainActivity.onCreate antes de que llegue la
             primera notificación (para entonces la app ya se abrió al menos
             una vez, que es como se registró el token). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pedidos_nuevos" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- CU-32: la vuelta desde Mercado Pago. La Edge Function
                 `retorno_pago` redirige a laburito://laburito/profesional/billetera
                 y Flutter le pasa la ruta a go_router. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="laburito" android:host="laburito"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sprint 4 (url_launcher): abrir el checkout de Mercado Pago, el
             comprobante en PDF y el chat de WhatsApp. Desde Android 11, sin
             declarar la intención la app no ve quién puede abrir la URL. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- CU-16: posición del dispositivo para «Usar mi ubicación». -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- CU-21: Android 13+ exige este permiso aparte para mostrar cualquier
         notificación. Sin él, FCM entrega el mensaje igual pero no se ve. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
</manifest>
